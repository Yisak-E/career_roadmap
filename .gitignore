# generated full CV (rebuild any time); per-application resumes ARE tracked so you know what you sent
output/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
~$*
# private documents you don't want in history — keep them local
Certifications/files/private/

# personal / sensitive data (passport, DOB, photo) — never commit
private/
# generated resumes contain personal details — rebuild from job.md + tailor.yml instead
applications/*/*.html
applications/*/*.pdf
applications/*/*.docx
applications/*/*.md
!applications/*/job.md
